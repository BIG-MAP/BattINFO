@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix battinfo: <https://w3id.org/battinfo#> .
@prefix schema:  <https://schema.org/> .

# ---------------------------------------------------------------------------
# BattINFO application ontology
#
# ROLE (IDENTIFIER_POLICY.md section 14): this file is the EMMO import/pin
# manifest for the BattINFO stack. It deliberately defines NO terms of its
# own: quantities and battery concepts live in the imported EMMO modules
# (missing terms are added upstream, not minted here), and administrative
# record predicates use dcterms/PROV/DCAT/schema.org/PAV. w3id serves this
# file at https://w3id.org/battinfo (the newest release) and at
# https://w3id.org/battinfo/X.Y.Z for each release (RELEASING.md).
#
# Companions (slash namespace, record layer):
#   assets/vocab/battinfo-records.ttl - the closed inventory of battinfo:
#     record-layer placeholder terms (scripts/gen_battinfo_vocab.py)
#   assets/vocab/emmo-labels.ttl - skos:prefLabel companion for every EMMO
#     term the record emitters use (scripts/gen_emmo_labels.py)
#
# EMMO dependency versions (pinned 2026-10-12):
#   domain-battery            0.21.0
#   domain-electrochemistry   0.39.0
#   domain-chemical-substance 0.15.0
#   EMMO core                 1.0.2
#
# To check for upstream updates run:
#   python .tools/quality/check_emmo_versions.py
# ---------------------------------------------------------------------------

battinfo: a owl:Ontology ;

    owl:versionIRI <https://w3id.org/battinfo/0.8.0/battinfo> ;
    owl:versionInfo "0.8.0" ;

    # Pinned EMMO domain imports.  Use versioned IRIs so that records
    # published against this ontology remain interpretable even after
    # upstream releases.  domain-battery imports domain-electrochemistry
    # and domain-chemical-substance transitively; we declare them
    # explicitly here for transparency and to document the exact versions
    # tested against this application ontology.
    owl:imports <https://w3id.org/emmo/domain/battery/0.21.0/battery> ;
    owl:imports <https://w3id.org/emmo/domain/electrochemistry/0.39.0/electrochemistry> ;
    owl:imports <https://w3id.org/emmo/domain/chemical-substance/0.15.0/chemical-substance> ;

    dcterms:title "Battery Interface Ontology (BattINFO)"@en ;

    dcterms:description """Application/profile ontology for the BattINFO battery data ecosystem.
Imports the EMMO domain-battery and domain-electrochemistry modules and provides
the semantic foundation for BattINFO canonical records, JSON schemas, and JSON-LD exports."""@en ;

    dcterms:abstract """BattINFO is an implementation and interoperability layer for the
EMMO-based domain-battery ontology. It provides Python tooling, JSON schemas,
semantic mapping tables, and JSON-LD transformation pipelines for authoring,
validating, and publishing battery cell records, test protocols, and datasets
as Linked Data."""@en ;

    dcterms:creator
        "Simon Clark (SINTEF Industry, NO)"@en ,
        "Casper Welzel Andersen"@en ,
        "Francesca Lønstad Bleken"@en ;
    dcterms:contributor
        "BattINFO contributors — see https://w3id.org/battinfo for full list"@en ;

    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:rights "Apache License 2.0"@en ;
    dcterms:source <https://github.com/BIG-MAP/BattINFO> ;

    rdfs:seeAlso <https://w3id.org/emmo/domain/battery> ;
    rdfs:seeAlso <https://w3id.org/emmo/domain/electrochemistry> ;
    # Record-layer companions under the slash namespace: the battinfo:
    # placeholder vocabulary and the EMMO prefLabel companion.
    rdfs:seeAlso <https://w3id.org/battinfo/> ;

    rdfs:label "BattINFO application ontology"@en ;
    rdfs:comment """Application ontology = EMMO import/pin manifest. No terms are defined here (IDENTIFIER_POLICY.md section 14): battery concepts come from the pinned EMMO imports; record-layer battinfo: placeholder terms are declared in assets/vocab/battinfo-records.ttl and human-readable labels for the EMMO terms the emitters use in assets/vocab/emmo-labels.ttl. EMMO dependency versions pinned in owl:imports; run .tools/quality/check_emmo_versions.py to check for upstream updates."""@en .

# ---------------------------------------------------------------------------
# Annotation properties declared so OWL tools do not warn about unknown
# annotation properties from the dcterms vocabulary.
# ---------------------------------------------------------------------------

dcterms:title       a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:abstract    a owl:AnnotationProperty .
dcterms:creator     a owl:AnnotationProperty .
dcterms:contributor a owl:AnnotationProperty .
dcterms:license     a owl:AnnotationProperty .
dcterms:rights      a owl:AnnotationProperty .
dcterms:source      a owl:AnnotationProperty .
