# Battery Data Commons vocabulary, release 1.0.1
#
# Publisher: Battery Data Commons, prefix 1002 in src/battinfo/data/namespace/prefixes.json.
# A released folder is never edited; a change is a new release in a new folder.
#
# Release 1.0.1 names the creators of the vocabulary, the people the Battery Data Commons
# site lists, by their ORCID iDs, and their organizations by their ROR IDs. Its terms are
# those of release 1.0.0, unchanged.
#
# The labels of the EMMO classes named in skos:relatedMatch are comments here, not statements
# about those classes.
#
# Licence of this file: CC BY 4.0, whatever the licence of the repository that holds it.

@prefix bdcv:    <https://w3id.org/battinfo/def/1002/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix schema:  <https://schema.org/> .
@prefix emmo:    <https://w3id.org/emmo#> .
@prefix echem:   <https://w3id.org/emmo/domain/electrochemistry#> .
@prefix battery: <https://w3id.org/emmo/domain/battery#> .

<https://w3id.org/battinfo/def/1002> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/battinfo/def/1002/1.0.1> ;
    owl:versionInfo "1.0.1" ;
    owl:priorVersion <https://w3id.org/battinfo/def/1002/1.0.0> ;
    dcterms:issued "2026-10-30"^^xsd:date ;
    dcterms:title "Battery Data Commons vocabulary"@en ;
    dcterms:description "Terms defined by Battery Data Commons under its publisher prefix 1002. It holds one concept scheme, the kinds of dataset the catalogue records."@en ;
    dcterms:publisher [ a foaf:Organization ;
        foaf:name "Battery Data Commons" ;
        foaf:homepage <https://batterydatacommons.org/> ] ;
    dcterms:creator
        <https://orcid.org/0000-0003-4713-5220>,
        <https://orcid.org/0000-0003-3041-1436>,
        <https://orcid.org/0000-0002-5900-1409>,
        <https://orcid.org/0000-0003-4447-9319>,
        <https://orcid.org/0000-0002-8758-6109>,
        <https://orcid.org/0000-0001-8834-9458>,
        <https://orcid.org/0000-0002-4993-2672> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

