bdcv:DatasetKind a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://w3id.org/battinfo/def/1002> ;
    dcterms:title "Dataset kinds"@en ;
    skos:definition "The kinds of dataset catalogued by Battery Data Commons. A dataset record carries one primary kind (data_group) and may carry further kinds (categories); all are expressed as dcat:theme on the dataset."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:hasTopConcept bdcv:PerformanceData, bdcv:DurabilityData, bdcv:SafetyData, bdcv:FieldData, bdcv:ModelingData .

bdcv:PerformanceData a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/battinfo/def/1002> ;
    skos:inScheme bdcv:DatasetKind ;
    skos:topConceptOf bdcv:DatasetKind ;
    skos:notation "PerformanceData" ;
    skos:prefLabel "Performance data"@en ;
    skos:altLabel "performance"@en ;
    skos:definition "Datasets from laboratory tests that characterise how a cell performs at a given point in its life: capacity, internal resistance, impedance, open-circuit voltage, and their dependence on rate, temperature and state of charge."@en ;
    skos:scopeNote "Typically reference performance tests at one or a few states of health. A dataset that follows the same quantities through ageing is durability data."@en ;
    skos:relatedMatch echem:electrochemistry_c7e37e88_ed86_4acd_99ee_b6a2a5fcbd24 .    # ReferencePerformanceTest

bdcv:DurabilityData a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/battinfo/def/1002> ;
    skos:inScheme bdcv:DatasetKind ;
    skos:topConceptOf bdcv:DatasetKind ;
    skos:notation "DurabilityData" ;
    skos:prefLabel "Durability data"@en ;
    skos:altLabel "durability"@en ;
    skos:definition "Datasets that follow cells through ageing: cycling or calendar-ageing campaigns, usually with periodic check-ups, so that the change of performance over life can be studied."@en ;
    skos:scopeNote "Includes the check-up measurements taken during the campaign. The ageing protocol is described in the record's durability block."@en ;
    skos:relatedMatch echem:electrochemistry_435b22d4_c441_45ea_8c79_0cbec11fd287 .    # CyclingTest

bdcv:SafetyData a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/battinfo/def/1002> ;
    skos:inScheme bdcv:DatasetKind ;
    skos:topConceptOf bdcv:DatasetKind ;
    skos:notation "SafetyData" ;
    skos:prefLabel "Safety data"@en ;
    skos:altLabel "safety"@en ;
    skos:definition "Datasets from abuse and safety testing: thermal, mechanical or electrical abuse, thermal runaway, and the heat, gas and venting behaviour observed."@en ;
    skos:relatedMatch battery:battery_0415f8c5_ac75_4020_b339_bba5a4f5aef4 .    # ThermalRunawayTest

bdcv:FieldData a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/battinfo/def/1002> ;
    skos:inScheme bdcv:DatasetKind ;
    skos:topConceptOf bdcv:DatasetKind ;
    skos:notation "FieldData" ;
    skos:prefLabel "Field data"@en ;
    skos:altLabel "field"@en ;
    skos:definition "Datasets recorded from cells, modules or packs in service outside the laboratory, such as vehicles and stationary storage, including drive-cycle and usage logs."@en ;
    skos:scopeNote "Field data says where the data came from, not what it measures; a field dataset often also carries performance or durability information and may be classified under those kinds as well."@en .

bdcv:ModelingData a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/battinfo/def/1002> ;
    skos:inScheme bdcv:DatasetKind ;
    skos:topConceptOf bdcv:DatasetKind ;
    skos:notation "ModelingData" ;
    skos:prefLabel "Modelling data"@en ;
    skos:altLabel "modelling"@en ;
    skos:definition "Datasets produced by or for models: parameter sets, simulation inputs and outputs, and the measurements used to fit or validate a model."@en ;
    skos:narrower bdcv:SyntheticData ;
    skos:relatedMatch emmo:EMMO_9335cf09_431f_4613_9dab_ce4ceaca965b .    # Simulation

bdcv:SyntheticData a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/battinfo/def/1002> ;
    skos:inScheme bdcv:DatasetKind ;
    skos:notation "SyntheticData" ;
    skos:prefLabel "Synthetic data"@en ;
    skos:definition "Datasets generated by simulation or generative methods rather than measured on physical cells."@en ;
    skos:scopeNote "A kind of modelling data. Assigned when a modelling record describes its data as synthetic."@en ;
    skos:broader bdcv:ModelingData ;
    skos:relatedMatch emmo:EMMO_9335cf09_431f_4613_9dab_ce4ceaca965b .    # Simulation
