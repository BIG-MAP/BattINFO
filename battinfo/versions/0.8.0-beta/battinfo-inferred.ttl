                                               owl:onProperty <https://w3id.org/emmo#EMMO_23b579e1_8088_45b5_9975_064014026c42> ;
                                               owl:hasValue "mol"
                                             ] ;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Mole"@en ;
                             <https://w3id.org/emmo#EMMO_0b1cbe60_d380_4787_b92e_be26bdacf2c2> "C34" ;
                             <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/MOL" ;
