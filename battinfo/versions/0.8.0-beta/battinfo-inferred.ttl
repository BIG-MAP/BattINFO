                                                               owl:hasValue "0.0"^^xsd:double
                                                             ] ;
                                             rdfs:isDefinedBy "http://qudt.org/2.1/vocab/unit" ;
                                             <http://www.w3.org/2004/02/skos/core#altLabel> "Square Metre per Second"@en ;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "SquareMetrePerSecond"@en ;
                                             <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/M2-PER-SEC" ;
                                             <https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652> "m2.s-1" ,
                                                                                                               "m2/s" ;
                                             <https://w3id.org/emmo#EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64> "m²/s" ;
                                             <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> """Square Metres per second is the SI derived unit of angular momentum, defined by distance or displacement in metres multiplied by distance again in metres and divided by time in seconds. The unit is written in symbols as m2/s or m2u00b7s-1 or m2s-1. It may be better understood when phrased as \"metres per second times metres\", i.e. the momentum of an object with respect to a position.

-- QUDT"""@en .


