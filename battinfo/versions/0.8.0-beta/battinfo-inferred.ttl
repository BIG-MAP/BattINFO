                                                                    owl:hasValue "1.0"^^xsd:double
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd> ;
                                                                    owl:hasValue "0.0"^^xsd:double
                                                                  ] ;
                                                  rdfs:isDefinedBy "http://qudt.org/2.1/vocab/unit" ;
                                                  <http://www.w3.org/2004/02/skos/core#altLabel> "Newton second per Cubic Metre"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "NewtonSecondPerCubicMetre"@en ;
                                                  <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/N-SEC-PER-M3" ;
