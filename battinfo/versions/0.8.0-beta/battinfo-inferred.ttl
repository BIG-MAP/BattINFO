<https://w3id.org/emmo#EMMO_66bc9029_f473_45ff_bab9_c3509ff37a22> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <https://w3id.org/emmo#EMMO_2946d40b_24a1_47fa_8176_e3f79bb45064> ,
