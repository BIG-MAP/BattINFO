###  https://w3id.org/emmo#Dalton
<https://w3id.org/emmo#Dalton> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/emmo#EMMO_3ee80521_3c23_4dd1_935d_9d522614a3e2> ,
                                               <https://w3id.org/emmo#EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa> ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/emmo#EMMO_23b579e1_8088_45b5_9975_064014026c42> ;
                                                 owl:hasValue "Da"
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf> ;
                                                 owl:hasValue "1.660539E-27"^^xsd:double
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd> ;
                                                 owl:hasValue "0.0"^^xsd:double
                                               ] ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Dalton"@en ;
                               <https://w3id.org/emmo#EMMO_0b1cbe60_d380_4787_b92e_be26bdacf2c2> "D43" ;
                               <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/Da"^^xsd:anyURI ;
                               <https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652> "u" ;
                               <https://w3id.org/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25> "http://dbpedia.org/page/Unified_atomic_mass_unit" ;
                               <https://w3id.org/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84> "One dalton is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state."@en ;
                               <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> """The unified atomic mass unit (symbol: μ) or dalton (symbol: Da) is a unit that is used for indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state, and has a value of 1.660538782(83) × 10⁻²⁷ kg. One Da is approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a \"non-SI unit whose values in SI units must be obtained experimentally\".

-- QUDT"""@en ;
                               <https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d> "http://en.wikipedia.org/wiki/Atomic_mass_unit"^^xsd:anyURI ;
                               <https://w3id.org/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2> "https://doi.org/10.1351/goldbook.D01514" .


