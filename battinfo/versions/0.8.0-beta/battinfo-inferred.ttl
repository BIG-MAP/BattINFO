                                                                                                      rdfs:subClassOf <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_468b3b63_b62a_4110_8c7e_40fffd5fdfd6> ,
                                                                                                                      <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_e4b6cb36_4dac_49e3_871d_40bcfca943a5> ;
                                                                                                      owl:deprecated "true"^^xsd:boolean ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#altLabel> "LMFPElectrode"@en ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "LithiumManganeseIronPhosphateElectrode"@en ;
