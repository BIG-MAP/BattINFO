   owl:annotatedSource <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b76a778f_253f_4210_a67f_fb6444d0de26> ;
   owl:annotatedProperty <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> ;
   owl:annotatedTarget "mercury electrode formed by sequence of mercury drops falling from a small aperture"@en ;
