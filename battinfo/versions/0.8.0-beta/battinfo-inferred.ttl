                                              ] ;
                              rdfs:comment "Other used symbols for litre are \"l\" and \"ℓ\"."@en ;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "liter"@en-us ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Litre"@en ;
                              <https://w3id.org/emmo#EMMO_0b1cbe60_d380_4787_b92e_be26bdacf2c2> "B51" ;
