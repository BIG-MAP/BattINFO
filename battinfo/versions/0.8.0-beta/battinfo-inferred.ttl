                                                         owl:hasValue "1.0"^^xsd:double
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd> ;
                                                         owl:hasValue "0.0"^^xsd:double
                                                       ] ;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "MetrePerSecond"@en ;
                                       <https://w3id.org/emmo#EMMO_0b1cbe60_d380_4787_b92e_be26bdacf2c2> "MTS" ;
                                       <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/M-PER-SEC" ;
                                       <https://w3id.org/emmo#EMMO_209ba1b3_149f_4ff0_b672_941610eafd72> "http://www.ontology-of-units-of-measure.org/resource/om-2/metrePerSecond-Time" ;
