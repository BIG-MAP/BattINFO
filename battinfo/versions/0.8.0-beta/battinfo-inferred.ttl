                                                                  rdfs:domain <https://w3id.org/emmo#EMMO_c6d4a5e0_7e95_44df_a6db_84ee0a8bbc8e> ;
                                                                  rdfs:range <https://w3id.org/emmo#EMMO_216f448e_cdbc_4aeb_a529_7a5fe7fc38bb> ;
                                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasUnitSymbol"@en ;
