<https://w3id.org/emmo#EMMO_c5ae6d8e_6b39_431f_8de4_ae4e357abc04> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <https://w3id.org/emmo#EMMO_649bf97b_4397_4005_90d9_219755d92e34> ;
