                                                                                                    )
                                                                                      ] ;
                                                                  rdfs:subClassOf <https://w3id.org/emmo#EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba> ,
                                                                                  <https://w3id.org/emmo#EMMO_c9805ac9_a943_4be4_ac4b_6da64ba36c73> ,
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty <https://w3id.org/emmo#EMMO_67fc0a36_8dcb_4ffa_9a43_31074efa3296> ;
                                                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                    owl:onClass <https://w3id.org/emmo#EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae>
                                                                                  ] ;
                                                                  owl:disjointUnionOf ( <https://w3id.org/emmo#EMMO_a9a6ddf8_7e16_420a_9f3d_df7d5cfe3536>
