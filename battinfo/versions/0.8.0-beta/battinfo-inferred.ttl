                                                                  <https://w3id.org/emmo#EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f> "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-25" ;
                                                                  <https://w3id.org/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25> "https://dbpedia.org/page/Electric_potential" ;
                                                                  <https://w3id.org/emmo#EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578> "6-11.1" ;
