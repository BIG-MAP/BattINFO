                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty <https://w3id.org/emmo#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569> ;
                                                                                    owl:someValuesFrom <https://w3id.org/emmo#EMMO_33433bb1_c68f_45ee_a466_f01e2c57b214>
                                                                                  ] ;
