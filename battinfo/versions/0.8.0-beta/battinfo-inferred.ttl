###  https://w3id.org/emmo#Gray
<https://w3id.org/emmo#Gray> rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/emmo#EMMO_847f1d9f_205e_46c1_8cb6_a9e479421f88> ,
                                             <https://w3id.org/emmo#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b> ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <https://w3id.org/emmo#EMMO_23b579e1_8088_45b5_9975_064014026c42> ;
                                               owl:hasValue "Gy"
                                             ] ;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Gray"@en ;
                             <https://w3id.org/emmo#EMMO_0b1cbe60_d380_4787_b92e_be26bdacf2c2> "A95" ;
                             <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/GRAY" ;
                             <https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652> "Gy" ;
                             <https://w3id.org/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25> "http://dbpedia.org/resource/Grey"^^xsd:anyURI ;
                             <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> "SI unit for absorbed dose."@en ;
                             <https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f> """The SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT""" ;
                             <https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d> "//en.wikipedia.org/wiki/Grey?oldid=494774160"^^xsd:anyURI ;
                             <https://w3id.org/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2> "https://doi.org/10.1351/goldbook.G02696" .


