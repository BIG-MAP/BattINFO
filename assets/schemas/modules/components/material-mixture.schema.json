{
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/battinfo/schema/modules/components/material-mixture.schema.json",
  "title": "Material Mixture",
  "description": "Mixture of named material components.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component"
  ],
  "properties": {
    "component": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "material-component.schema.json"
      },
      "description": "Component materials of the mixture, each with its fraction under property: volume_fraction (v/v) or mass_fraction (w/w), using one basis for the whole mixture."
    },
    "manufacturer": {
      "type": "string",
      "description": "Manufacturer of the item."
    },
    "supplier": {
      "type": "string",
      "description": "Supplier or vendor the item was sourced from."
    },
    "product_id": {
      "type": "string",
      "description": "Manufacturer or supplier product/grade identifier."
    },
    "property": {
      "$ref": "../common/quantitative-properties.schema.json",
      "description": "Named quantity map of technical properties (snake_case key to value+unit quantity)."
    },
    "comment": {
      "type": "string",
      "description": "Free-text comment."
    }
  }
}
