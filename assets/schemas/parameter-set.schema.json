{
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/battinfo/schema/parameter-set.schema.json",
  "title": "BattINFO Parameter Set",
  "description": "A batch of parameter claims from one source about one target (a material kind, a material spec, or a cell spec). Claims collate under the target: many parameter sets may state values for the same parameter of the same material, and the spread is the point. One source (paper, BPX file, lab fit) = one record; the record-level provenance block carries the source, each claim carries its own provenance class (measured/fitted/literature/assumed/derived).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parameter_set",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$"
    },
    "parameter_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "claims"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/SpecIri"
        },
        "short_id": {
          "$ref": "#/$defs/ShortId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable label for this batch of claims, conventionally '<source> - <target>' (e.g. 'Chen 2020 - graphite')."
        },
        "material_kind": {
          "type": "string",
          "minLength": 1,
          "description": "Target: a generic material kind key from the curated material_kinds vocabulary (e.g. 'graphite', 'nmc811'). Claims about the generic chemistry collate here; resolution falls back from a product-specific material spec to its kind."
        },
        "material_spec_id": {
          "$ref": "#/$defs/MaterialSpecIri",
          "description": "Target: a specific material spec (a vendor product/grade). Use for claims measured on a particular product rather than the generic chemistry."
        },
        "cell_spec_id": {
          "$ref": "#/$defs/SpecIri",
          "description": "Target: a cell spec. Use for cell-level fitted sets (full-cell parameterizations, ECM fits) and for electrode/separator/electrolyte claims that describe this cell's build rather than a material."
        },
        "scope": {
          "type": "string",
          "enum": [
            "material",
            "electrode",
            "separator",
            "electrolyte",
            "cell"
          ],
          "description": "Physical scope the claims describe. Defaults (in the builder) to 'material' for material targets and 'cell' for cell-spec targets. Electrode/separator/electrolyte scopes carry manufactured-build parameters (thickness, porosity, transport) that belong to a cell design, not to a powder."
        },
        "electrode_polarity": {
          "type": "string",
          "enum": [
            "positive",
            "negative"
          ],
          "description": "For electrode-scope claims on a cell-spec target: which electrode the claims describe."
        },
        "model_context": {
          "type": "object",
          "additionalProperties": false,
          "description": "The digital artifact these claims came from, when they were imported from a modelling parameter set (BPX file, PyBaMM parameter set, ...).",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1,
              "description": "Source tool/format (e.g. 'BPX', 'PyBaMM', 'BattMo')."
            },
            "name": {
              "type": "string",
              "description": "Name of the parameter set in the source tool (e.g. 'Chen2020')."
            },
            "model": {
              "type": "string",
              "description": "Model type the source parameterises (e.g. 'DFN', 'SPMe')."
            },
            "version": {
              "type": "string",
              "description": "Source format/schema version (e.g. the BPX version)."
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "description": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "material_kind"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "material_spec_id"
                ]
              },
              {
                "required": [
                  "cell_spec_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "material_spec_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "material_kind"
                ]
              },
              {
                "required": [
                  "cell_spec_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "cell_spec_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "material_kind"
                ]
              },
              {
                "required": [
                  "material_spec_id"
                ]
              }
            ]
          }
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "funding": {
      "$ref": "#/$defs/Funding"
    },
    "contributor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Person"
      },
      "minItems": 1,
      "description": "People who contributed this record to the platform (attribution/provenance). Each is a schema:Person; an ORCID may be given in same_as. Stamped by ws.save."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "License under which this record is released, as an SPDX identifier (e.g. \"cc-by-4.0\") or a URL. Stamped from the workspace default (ws.license)."
    }
  },
  "$defs": {
    "SpecIri": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/spec/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$"
    },
    "MaterialSpecIri": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/(?:spec|material-spec)/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$"
    },
    "ShortId": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{6,16}$"
    },
    "UnixTime": {
      "type": "integer",
      "minimum": 0
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter"
      ],
      "properties": {
        "parameter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Canonical snake_case parameter key. Known keys come from the shipped parameters vocabulary (battinfo.parameters.parameter_keys()); unknown keys are allowed (tolerant import) but do not count toward model-tier completeness."
        },
        "quantity": {
          "$ref": "modules/common/quantity.schema.json",
          "description": "Scalar value (with unit, optional min/max/std/conditions). Exactly one of quantity, curve, expression must be present."
        },
        "curve": {
          "$ref": "#/$defs/Curve"
        },
        "expression": {
          "$ref": "#/$defs/Expression"
        },
        "provenance_class": {
          "type": "string",
          "enum": [
            "measured",
            "fitted",
            "literature",
            "assumed",
            "derived"
          ],
          "description": "How this value was obtained: directly measured, fitted to data, taken from literature, assumed/engineering judgement, or derived from other parameters."
        },
        "method": {
          "type": "string",
          "description": "Measurement or fitting method behind the value (e.g. 'GITT', 'EIS', 'fit to 0.1C discharge')."
        },
        "conditions": {
          "type": "object",
          "description": "Conditions under which the claim holds (e.g. temperature, soc_window). Each entry is a quantity. For scalar claims, conditions may equivalently live inside quantity.conditions.",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "modules/common/quantity.schema.json"
            }
          },
          "additionalProperties": false
        },
        "citation": {
          "type": "string",
          "format": "uri",
          "description": "Per-claim source override when it differs from the record-level provenance citation."
        },
        "citation_doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$"
        },
        "comment": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "quantity"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "curve"
                ]
              },
              {
                "required": [
                  "expression"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "curve"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "quantity"
                ]
              },
              {
                "required": [
                  "expression"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "expression"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "quantity"
                ]
              },
              {
                "required": [
                  "curve"
                ]
              }
            ]
          }
        }
      ]
    },
    "Curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_quantity",
        "x",
        "y",
        "y_unit"
      ],
      "description": "Tabulated functional parameter y(x), e.g. an OCP curve vs stoichiometry or conductivity vs salt concentration. x and y must have the same length (builder-enforced).",
      "properties": {
        "x_quantity": {
          "type": "string",
          "minLength": 1,
          "description": "What x is (e.g. 'stoichiometry', 'concentration', 'temperature')."
        },
        "x_unit": {
          "type": "string",
          "description": "Unit of x; omit for dimensionless (e.g. stoichiometry)."
        },
        "x": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "y": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "y_unit": {
          "type": "string",
          "minLength": 1
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "linear",
            "cubic"
          ]
        },
        "branch": {
          "type": "string",
          "enum": [
            "lithiation",
            "delithiation",
            "average"
          ],
          "description": "For OCP curves: which hysteresis branch the curve represents. Matters for large-hysteresis materials (silicon)."
        }
      }
    },
    "Expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "language"
      ],
      "description": "Functional parameter given as an expression string (as BPX allows). Kept verbatim with its language tag; consumers that cannot evaluate it must treat the claim as opaque.",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": [
            "bpx",
            "python",
            "sympy"
          ]
        },
        "argument": {
          "type": "string",
          "description": "Name of the free variable (e.g. 'x' for stoichiometry, 'c' for concentration)."
        }
      }
    },
    "OrganizationIri": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/organization/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$"
    },
    "Organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "type": {
          "const": "Organization"
        },
        "id": {
          "$ref": "#/$defs/OrganizationIri"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "datasheet",
            "manufacturer",
            "measurement",
            "lab",
            "literature",
            "manual",
            "other"
          ]
        },
        "source_name": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "source_url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "type": "string",
          "format": "uri"
        },
        "citation_doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$"
        },
        "retrieved_at": {
          "$ref": "#/$defs/UnixTime"
        },
        "file_hash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "workflow_version": {
          "type": "string"
        },
        "curated_by": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "battinfo_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$"
        }
      }
    },
    "Funding": {
      "type": "object",
      "additionalProperties": false,
      "description": "Funding project (grant) under which the record was produced.",
      "required": [
        "identifier"
      ],
      "properties": {
        "type": {
          "const": "Grant"
        },
        "id": {
          "type": "string",
          "format": "uri"
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "acronym": {
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "funder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "type": {
              "const": "Organization"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "same_as": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "Person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "type": {
          "const": "Person"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "given_name": {
          "type": "string",
          "minLength": 1
        },
        "family_name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "same_as": {
          "type": "string",
          "format": "uri"
        },
        "affiliation": {
          "$ref": "#/$defs/Organization"
        }
      }
    }
  }
}
