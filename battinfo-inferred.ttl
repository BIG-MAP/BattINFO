                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty <https://w3id.org/emmo#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569> ;
                                                                                    owl:someValuesFrom <https://w3id.org/emmo#EMMO_95a9bf22_eabc_4a84_863d_9ea398c8a52e>
                                                                                  ] ;
                                                                  owl:disjointWith <https://w3id.org/emmo#EMMO_46406907_9afd_424e_934a_a523f9f9cc36> ,
                                                                                   <https://w3id.org/emmo#EMMO_90a39fcb_5087_451e_a92e_ce0adc6d80f1> ,
