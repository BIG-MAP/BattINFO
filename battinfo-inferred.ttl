                                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInput"@en ;
                                                                  <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> "The relation between an entity and a process, where the entity is the input of that process."@en .


###  https://w3id.org/emmo#EMMO_3733bd38_ca2b_4264_a92a_3075a1715598
<https://w3id.org/emmo#EMMO_3733bd38_ca2b_4264_a92a_3075a1715598> rdf:type owl:ObjectProperty ;
                                                                  rdfs:subPropertyOf <https://w3id.org/emmo#EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6> ,
                                                                                     <https://w3id.org/emmo#EMMO_ebc9e62c_5dc4_44db_9060_7923740bdf78> ;
                                                                  owl:inverseOf <https://w3id.org/emmo#EMMO_451e410e_8e0d_4a4b_9211_d6ef619296dc> ;
                                                                  rdf:type owl:AsymmetricProperty ,
                                                                           owl:IrreflexiveProperty ;
                                                                  owl:propertyDisjointWith <https://w3id.org/emmo#EMMO_d01b3ee2_91a5_4ce2_95cd_f0d2c333c6d3> ;
                                                                  rdfs:isDefinedBy <https://w3id.org/emmo/mereocausality#> ;
                                                                  rdfs:seeAlso <https://w3id.org/emmo#EMMO_451e410e_8e0d_4a4b_9211_d6ef619296dc> ;
                                                                  <http://www.w3.org/2004/02/skos/core#altLabel> "hasSuccessor"@en ,
                                                                                                                 "isAntecedentOf"@en ,
                                                                                                                 "predecessorOf"@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#example> "My life between 18-24 years has successor my life between 32-40 years, since there is an intermediary (i.e. my life between 25-32 years)."@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "foreruns"@en ;
                                                                  <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> "A causal relation between the y effected and the x causing entities with intermediaries, where x isCauseOf y and not(y isCauseOf x)."@en ;
                                                                  <https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f> "Transitivity is implemented at A-Box level with a SWRL rule."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://w3id.org/emmo#EMMO_3733bd38_ca2b_4264_a92a_3075a1715598> ;
   owl:annotatedProperty <http://www.w3.org/2004/02/skos/core#altLabel> ;
   owl:annotatedTarget "hasSuccessor"@en ;
   <https://w3id.org/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25> "From Latin succedĕre (\"coming after\")."@en
 ] .


