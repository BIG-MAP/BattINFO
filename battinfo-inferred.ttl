###  https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7fe804b8_6126_4132_be8f_b4985d61b1f6
<https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7fe804b8_6126_4132_be8f_b4985d61b1f6> rdf:type owl:Class ;
                                                                                                      rdfs:subClassOf <https://w3id.org/emmo#EMMO_88fc5d1b_d3ab_4626_b24c_915ebe7400ca> ,
                                                                                                                      <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_2d896559_eee3_447c_9759_87c854a4266a> ,
                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                        owl:onProperty <https://w3id.org/emmo#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569> ;
                                                                                                                        owl:someValuesFrom <https://w3id.org/emmo#EMMO_0972cb08_48bd_4524_ac03_8a2e7f30f02f>
                                                                                                                      ] ;
                                                                                                      rdfs:comment "A charge-transfer reaction is at equilibrium when the electrochemical potentials of its reactants and products balance; the equilibrium electrode potential and the equilibrium cell voltage follow from that condition, which the Nernst equation expresses in terms of activities. This is the quantity IUPAC calls electrochemical potential; ElectrochemicalPotential in this ontology is the per-particle counterpart."@en ,
                                                                                                                   "Of a substance in a specified phase, the partial molar Gibbs energy of the substance at the specified electric potential."@en ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "MolarElectrochemicalPotential"@en ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#related> <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_1422cde1_929e_46b6_b0dc_1010eebc5dfd> ,
                                                                                                                                                    <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_53616dc6_b921_4beb_9ab2_cafa4ba16406> ,
                                                                                                                                                    <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d91940f0_c8b6_4505_9b68_6bf6cfc5c544> ,
                                                                                                                                                    <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_fe3a6c9a_85b8_4da6_aa4f_71c8de74939e> ;
                                                                                                      <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> "partial molar Gibbs energy of a charged species at a specified electric potential: the sum of its chemical potential and the product of its charge number, the Faraday constant and the electric potential"@en ;
                                                                                                      <https://w3id.org/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2> "https://goldbook.iupac.org/terms/view/E01945" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_7fe804b8_6126_4132_be8f_b4985d61b1f6> ;
   owl:annotatedProperty <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> ;
   owl:annotatedTarget "partial molar Gibbs energy of a charged species at a specified electric potential: the sum of its chemical potential and the product of its charge number, the Faraday constant and the electric potential"@en ;
   dcterms:source "Atkins and DePaula, Aktins' Physical Chemistry, 8th ed., p.952"
 ] .


