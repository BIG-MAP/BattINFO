                                                                                                      <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_69022178_77b8_4669_97e2_351d45356e5a> "Ecell/V"@en ;
                                                                                                      <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_811aafc3_0c6d_470e_b67e_ff5c82992609> "Voltage(V)"@en ;
                                                                                                      <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_8377c1f7_2b09_4632_9a4d_bb318438adbb> "cell_voltage_v"@en ;
                                                                                                      <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a07dd85b_d0df_4d5d_8b0c_14d20ea3fe45> "voltage"@en ;
                                                                                                      <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_ea9f4dba_8ca2_419e_9cdf_ce54e9ebbd46> "Potential (V)"@en .

