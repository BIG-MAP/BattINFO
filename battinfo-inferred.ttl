   owl:annotatedSource <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_2d32a81a_2148_41bd_84fb_467aa8de4a8f> ;
   owl:annotatedProperty <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> ;
   owl:annotatedTarget "foil, wire, disc, or mesh electrode made of platinum, which is the most commonly used metallic working electrode in electrochemistry"@en ;
