                                      <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> """'Volt per Second' is a unit of magnetic flux equaling one weber. This is the flux passing through a conducting loop and reduced to zero at a uniform rate in one second inducing an electric potential of one volt in the loop.

-- QUDT"""@en .


###  https://w3id.org/emmo#VoltPerSquareMetre
<https://w3id.org/emmo#VoltPerSquareMetre> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/emmo#EMMO_1273eb34_de48_43a9_925f_104110469dd2> ,
                                                           <https://w3id.org/emmo#EMMO_a5111335_6d14_49d9_ba7a_10c10b2189e7> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf> ;
                                                             owl:hasValue "1.0"^^xsd:double
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd> ;
                                                             owl:hasValue "0.0"^^xsd:double
                                                           ] ;
                                           rdfs:isDefinedBy "http://qudt.org/2.1/vocab/unit" ;
                                           rdfs:seeAlso "http://www.funtrivia.com/en/subtopics/Physical-Quantities-310909.html" ;
                                           <http://www.w3.org/2004/02/skos/core#altLabel> "Volt per Square Metre"@en ;
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "VoltPerSquareMetre"@en ;
                                           <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/V-PER-M2" ;
