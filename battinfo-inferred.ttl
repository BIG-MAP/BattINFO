<https://w3id.org/emmo#Degree> rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/emmo#EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac> ,
                                               <https://w3id.org/emmo#EMMO_be8680e5_28ec_4168_9206_d1cd33fbd458> ,
