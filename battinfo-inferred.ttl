                                                                                                      <https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d> "https://en.wikipedia.org/wiki/Electrode_potential" ;
                                                                                                      <https://w3id.org/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2> "https://goldbook.iupac.org/terms/view/E01956" .

