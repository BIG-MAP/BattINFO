                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "WattPerSteradian"@en ;
                                         <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/W-PER-SR" ;
