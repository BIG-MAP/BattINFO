                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/emmo#EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8> ;
                                                    owl:hasValue "″"
                                                  ] ;
                                  rdfs:isDefinedBy "http://qudt.org/2.1/vocab/unit" ;
                                  <http://www.w3.org/2004/02/skos/core#altLabel> "ArcSecond"@en ,
                                                                                 "SecondOfArc"@en ;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Arcsecond"@en ;
                                  schema:unitCode "D62" ;
                                  <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/ARCSEC" ;
                                  <https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652> "''" ;
