#################################################################
#    Annotations
#################################################################

<https://w3id.org/emmo#EMMO_8ef3cd6d_ae58_4a8d_9fc0_ad8f49015cd0> rdfs:comment "Relates a quantity to its numerical value through spatial direct parthood."@en ;
                                                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasNumericalPart"@en .


<https://w3id.org/emmo#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569> rdfs:comment "A conventional semiotic relation that relates a physical quantity to its unit."@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#example> "Length hasUnit only LengthUnit"@en ;
                                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMeasurementUnit"@en .


<https://w3id.org/emmo#EMMO_e1097637_70d2_4895_973f_2396f04fa204> rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
                                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasProperty"@en ;
                                                                  <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> "A semiotic relation that connects a semiotic object to a property in a declaration process."@en .


<https://w3id.org/emmo#EMMO_faf79f53_749d_40b2_807c_d34244c192f4> <http://www.w3.org/2004/02/skos/core#prefLabel> "hasNumberValue"@en ;
                                                                  <https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f> "The owl:dataProperty that provides a serialisation of an EMMO numerical data entity." .


<https://w3id.org/emmo#material_c5c9cf9f_252e_4b28_90f6_56b500db67fc> <http://www.w3.org/2004/02/skos/core#prefLabel> "deprecate_OrganicCompound"@en .


