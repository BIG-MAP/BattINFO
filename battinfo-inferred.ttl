<https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b6f33044_1892_41a4_ae89_8683d4225f8d> rdf:type owl:Class ;
                                                                                                      rdfs:subClassOf <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_c4120ce7_f1ff_4917_b59e_002454a65040> ;
