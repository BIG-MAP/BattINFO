###  https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a9cbffd9_2a4b_46e9_97af_7403a64364da
<https://w3id.org/emmo/domain/electrochemistry#electrochemistry_a9cbffd9_2a4b_46e9_97af_7403a64364da> rdf:type owl:Class ;
                                                                                                      rdfs:subClassOf <https://w3id.org/emmo#EMMO_88fc5d1b_d3ab_4626_b24c_915ebe7400ca> ,
                                                                                                                      <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_2d896559_eee3_447c_9759_87c854a4266a> ,
                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                        owl:onProperty <https://w3id.org/emmo#EMMO_b3ddad94_ef7e_4b97_8329_9e7c788dd94d> ;
                                                                                                                        owl:someValuesFrom <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_79d1b273_58cd_4be6_a250_434817f7c261>
                                                                                                                      ] ;
                                                                                                      rdfs:comment "What the open-circuit potential curve of an insertion electrode encodes: measured against a reference of the same species, the equilibrium open-circuit potential equals minus the difference in guest chemical potential between host and reference, divided by the charge number and the Faraday constant."@en ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "GuestChemicalPotential"@en ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#related> <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_e272f229_7b45_4436_9b0b_30391ee4e5be> ,
                                                                                                                                                    <https://w3id.org/emmo/domain/electrochemistry#electrochemistry_fed4582e_0de4_43e1_b51a_e3496697c25d> ;
                                                                                                      <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> "chemical potential of the guest species within the host active material of an insertion electrode"@en .


