                                                                                     rdfs:subClassOf <https://w3id.org/emmo/domain/characterisation-methodology/chameo#Osmometry> ;
                                                                                     rdfs:comment "In the membrane osmometry technique, a pure solvent and polymer solution are separated by a semipermeable membrane, due to the higher chemical potential of the solvent in the pure solvent than in polymer solution, the solvent starts moving towards the polymer solution." ;
                                                                                     rdfs:label "MembraneOsmometry"@en ;
