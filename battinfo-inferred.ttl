                                                                                                      rdfs:seeAlso "ACInternalResistance" ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#altLabel> "DCIR"@en ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#note> "Encompasses contributions from ohmic resistance and from electrochemical kinetic processes — charge-transfer resistance and short-timescale diffusion — active within the measurement interval. Typically reported in milliohms (mΩ)"@en ;
