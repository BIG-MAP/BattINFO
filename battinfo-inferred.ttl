                                                                                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "ParasiticReaction"@en ;
                                                                                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Parasitic reactions are a subset of side reactions specifically associated with unwanted charge transfer."@en ;
