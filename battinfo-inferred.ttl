                                                                         <https://w3id.org/emmo#EMMO_a94aec97_71ff_4574_b111_a52d77d2c230> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <https://w3id.org/emmo#EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4> ;
                                                                           owl:someValuesFrom <https://w3id.org/emmo#MolePerSquareMetrePerSecond>
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <https://w3id.org/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf> ;
                                                                           owl:hasValue "1.0E-6"^^xsd:double
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd> ;
                                                                           owl:hasValue "0.0"^^xsd:double
                                                                         ] ;
                                                         <http://www.w3.org/2004/02/skos/core#altLabel> "Micromoles per square metre per second"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "MicroMolePerSquareMetrePerSecond" ;
                                                         <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/MicroMOL-PER-M2-SEC" ;
