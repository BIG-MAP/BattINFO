###  https://w3id.org/emmo#Lumen
<https://w3id.org/emmo#Lumen> rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/emmo#EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3> ,
                                              <https://w3id.org/emmo#EMMO_14ff4393_0f28_4fb4_abc7_c2cc00bc761d> ,
                                              <https://w3id.org/emmo#EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45> ,
                                              <https://w3id.org/emmo#EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a> ,
                                              <https://w3id.org/emmo#EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b> ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/emmo#EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8> ;
                                                owl:hasValue "lm"
                                              ] ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Lumen"@en ;
                              schema:unitCode "LUM" ;
                              <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/LM" ;
                              <https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652> "lm" ;
                              <https://w3id.org/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25> "http://dbpedia.org/resource/Lumen"^^xsd:anyURI ;
                              <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> "SI unit for luminous flux."@en ;
                              <https://w3id.org/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f> """The SI unit for measuring the flux of light being produced by a light source or received by a surface. The intensity of a light source is measured in candelas. One lumen represents the total flux of light emitted, equal to the intensity in candelas multiplied by the solid angle in steradians into which the light is emitted. A full sphere has a solid angle of 4·π steradians. A light source that uniformly radiates one candela in all directions has a total luminous flux of 1 cd·4π sr = 4π cd·sr ≈ 12.57 lumens. \"Lumen\" is a Latin word for light.

-- QUDT"""@en ;
                              <https://w3id.org/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d> "https://en.wikipedia.org/wiki/Lumen_(unit)"^^xsd:anyURI ;
