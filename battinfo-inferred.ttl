                                                          owl:hasValue "1.0"^^xsd:double
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/emmo#EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd> ;
                                                          owl:hasValue "0.0"^^xsd:double
                                                        ] ;
                                        rdfs:isDefinedBy "http://qudt.org/2.1/vocab/unit" ;
                                        <http://www.w3.org/2004/02/skos/core#altLabel> "radian per second"@en ;
                                        <http://www.w3.org/2004/02/skos/core#prefLabel> "RadianPerSecond"@en ;
                                        <https://w3id.org/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc> "http://qudt.org/vocab/unit/RAD-PER-SEC" ;
                                        <https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652> "rad.s-1" ,
                                                                                                          "rad/s" ;
                                        <https://w3id.org/emmo#EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64> "rad/s" ;
                                        <https://w3id.org/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9> """\"Radian per Second\" is the SI unit of rotational speed (angular velocity), and, also the unit of angular frequency. The radian per second is defined as the change in the orientation of an object, in radians, every second.

-- QUDT"""@en .


