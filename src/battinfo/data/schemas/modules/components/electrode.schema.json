{
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/battinfo/schema/modules/components/electrode.schema.json",
  "title": "Electrode",
  "description": "Electrode model composed of coating, current collector, and optional properties.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "electrode_spec_id": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/spec/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$",
      "description": "Optional canonical IRI of a standalone electrode-spec this inline holder realizes. Lets a cell-spec cite the designed electrode while keeping its embedded fields; the same reference seam material-component.schema.json gives materials."
    },
    "coating": {
      "$ref": "electrode-coating.schema.json"
    },
    "current_collector": {
      "$ref": "current-collector.schema.json"
    },
    "manufacturer": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "property": {
      "$ref": "../common/quantitative-properties.schema.json"
    },
    "comment": {
      "type": "string"
    },
    "tab": {
      "type": "object",
      "title": "CurrentCollectorTab",
      "description": "Electrode current-collector tab (width, thickness, length, weld_width, tape_width)."
    }
  },
  "anyOf": [
    {
      "required": [
        "electrode_spec_id"
      ]
    },
    {
      "required": [
        "coating"
      ]
    },
    {
      "required": [
        "current_collector"
      ]
    },
    {
      "required": [
        "property"
      ]
    }
  ]
}
