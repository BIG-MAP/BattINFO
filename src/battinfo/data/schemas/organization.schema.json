{
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/battinfo/schema/organization.schema.json",
  "title": "BattINFO Organization",
  "description": "Canonical organization record (manufacturer, research lab, university, etc.) using schema.org Organization terms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organization",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
      "description": "Version of the record schema this document conforms to (semantic versioning); stamped by the library on save."
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/OrganizationIri",
          "description": "Canonical IRI of this organization record."
        },
        "short_id": {
          "$ref": "#/$defs/ShortId"
        },
        "type": {
          "type": "string",
          "enum": [
            "Organization",
            "Corporation",
            "Manufacturer",
            "ResearchOrganization",
            "EducationalOrganization",
            "GovernmentOrganization",
            "NGO",
            "Other"
          ],
          "description": "Organization kind (schema.org type)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Current preferred name of the organization."
        },
        "legalName": {
          "type": "string",
          "minLength": 1,
          "description": "Full legal name, if different from name."
        },
        "alternateName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ],
          "description": "Former names, abbreviations, or brand names (e.g. 'LG Chem' for LG Energy Solution)."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Official website URL."
        },
        "same_as": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ],
          "description": "Canonical external IRIs (Wikidata, ROR, GRID, LEI) that identify this organization."
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addressCountry": {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "description": "ISO 3166-1 alpha-2 country code."
            },
            "addressRegion": {
              "type": "string",
              "description": "State, province, or region."
            },
            "addressLocality": {
              "type": "string",
              "description": "City or locality."
            }
          },
          "description": "Headquarters or principal location."
        },
        "foundingDate": {
          "type": "string",
          "description": "Year or ISO 8601 date the organization was founded."
        },
        "dissolutionDate": {
          "type": "string",
          "description": "Year or ISO 8601 date the organization was dissolved, if applicable."
        },
        "description": {
          "type": "string",
          "description": "Short description of the organization."
        },
        "parentOrganization": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrganizationIri"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/OrganizationIri",
                  "description": "Canonical IRI of the parent organization record."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the parent organization."
                }
              }
            }
          ],
          "description": "Parent organization, if this is a subsidiary or division."
        }
      },
      "description": "The organization being described, in schema.org Organization terms."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "retrieved_at"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "inferred",
            "manual",
            "external",
            "knowledge_base",
            "other"
          ],
          "description": "Kind of source this record was created from."
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ],
          "description": "URL of the source document or landing page, when available."
        },
        "retrieved_at": {
          "$ref": "#/$defs/UnixTime",
          "description": "Unix timestamp (seconds since epoch, UTC) when the source was retrieved or the record was captured."
        },
        "battinfo_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
          "description": "Version of the battinfo library that wrote this record (semantic versioning); stamped on save."
        }
      },
      "description": "Where the information in this record came from: source type, file or URL, citation, and retrieval time."
    },
    "editorial": {
      "type": "object",
      "description": "Internal editorial metadata — not forwarded to the registry semantic payload.",
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-text notes carried with the record."
    }
  },
  "$defs": {
    "OrganizationIri": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/organization/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$",
      "description": "Canonical BattINFO IRI in the organization/ namespace (https://w3id.org/battinfo/organization/xxxx-xxxx-xxxx-xxxx)."
    },
    "ShortId": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{6,16}$",
      "description": "Short human-friendly identifier derived from the record IRI (Crockford base32, 6-16 characters)."
    },
    "UnixTime": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix timestamp in whole seconds since 1970-01-01T00:00:00Z."
    }
  }
}
