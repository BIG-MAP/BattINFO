{
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/battinfo/schema/dataset.schema.json",
  "title": "BattINFO Dataset (Schema.org-Aligned)",
  "description": "Canonical BattINFO dataset metadata using schema.org Dataset terms with minimal registry provenance extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
      "description": "Version of the record schema this document conforms to (semantic versioning); stamped by the library on save."
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identifier",
        "name",
        "access_url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/DatasetIri",
          "description": "Canonical IRI of this dataset record."
        },
        "short_id": {
          "$ref": "#/$defs/ShortId"
        },
        "identifier": {
          "$ref": "#/$defs/Identifier",
          "description": "Identifier(s) for the dataset (e.g. DOI, accession number), as strings or PropertyValue pairs."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Dataset title."
        },
        "description": {
          "type": "string",
          "description": "Free-text description of the dataset."
        },
        "access_url": {
          "type": "string",
          "format": "uri",
          "description": "Landing page or direct access URL for the dataset."
        },
        "same_as": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true,
          "description": "Other IRIs identifying the same dataset (e.g. a Zenodo DOI URL)."
        },
        "about": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AboutRef"
          },
          "uniqueItems": true,
          "description": "What the dataset is about: canonical cell or test IRIs, or external URIs. Source of truth for what a dataset describes; the cell-instance datasets list and test.dataset_ids are back-references derived from it."
        },
        "additional_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ],
          "description": "Extra JSON-LD type IRIs or labels stacked onto the record's @type."
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "License IRI or SPDX identifier governing reuse."
        },
        "version": {
          "type": "string",
          "description": "Dataset version label."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Free-text keywords for discovery."
        },
        "creators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonOrOrganization"
          },
          "minItems": 1,
          "description": "People and/or organizations that created the data."
        },
        "publisher": {
          "$ref": "#/$defs/Organization",
          "description": "Organization that published the dataset."
        },
        "funders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PersonOrOrganization"
          },
          "minItems": 1,
          "description": "Parties that funded creation of the dataset."
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "description": "Related works to cite alongside the dataset (papers, source datasets, software)."
        },
        "measurement_techniques": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "uniqueItems": true,
          "description": "Measurement techniques used, as labels or ontology IRIs."
        },
        "measurement_methods": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "uniqueItems": true,
          "description": "Measurement methods used, as labels or ontology IRIs."
        },
        "variable_measured": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariableMeasured"
          },
          "description": "Variables (columns or signals) recorded in the dataset."
        },
        "is_accessible_for_free": {
          "type": "boolean",
          "description": "Whether access is free of charge."
        },
        "conditions_of_access": {
          "type": "string",
          "description": "Human-readable access conditions (e.g. 'registration required')."
        },
        "in_language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "Language of the dataset metadata (BCP 47 tag)."
        },
        "created_at": {
          "$ref": "#/$defs/UnixTime",
          "description": "Unix timestamp when the dataset was created."
        },
        "modified_at": {
          "$ref": "#/$defs/UnixTime",
          "description": "Unix timestamp when the dataset was last modified."
        },
        "published_at": {
          "$ref": "#/$defs/UnixTime",
          "description": "Unix timestamp when the dataset was published."
        },
        "temporal_coverage": {
          "type": "string",
          "description": "Time period the data covers (ISO 8601 interval)."
        },
        "spatial_coverage": {
          "type": "string",
          "description": "Geographic area the data covers."
        },
        "distributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DataDistribution"
          },
          "minItems": 1,
          "description": "Downloadable files that make up the dataset."
        },
        "main_entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/CsvwMainEntity"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CsvwMainEntity"
              },
              "minItems": 1
            }
          ],
          "description": "CSVW table description(s) documenting the tabular structure of the data files (the data dictionary)."
        },
        "is_based_on": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true,
          "description": "URIs of resources this dataset is derived from."
        },
        "series_id": {
          "$ref": "#/$defs/DatasetIri"
        },
        "included_in_data_catalog": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "string",
              "format": "uri"
            },
            {
              "$ref": "#/$defs/DataCatalog"
            }
          ],
          "description": "Catalog(s) the dataset is listed in (e.g. the Battery Genome registry)."
        }
      },
      "description": "The dataset being described, in schema.org Dataset terms."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "retrieved_at"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "catalog",
            "measurement",
            "lab",
            "simulation",
            "external",
            "manual",
            "other"
          ],
          "description": "Kind of source this record was created from."
        },
        "source_name": {
          "type": "string",
          "description": "Human-readable name of the source (document title, instrument, lab, or system)."
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ],
          "description": "URL of the source document or landing page, when available."
        },
        "citation": {
          "type": "string",
          "format": "uri",
          "description": "Resolvable citation target to use for attribution, typically a DOI URL."
        },
        "citation_doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$",
          "description": "DOI of the source publication (bare '10.xxxx/...' form). Prefer provenance.citation with a DOI resolver URL."
        },
        "source_file": {
          "type": "string",
          "description": "Filename or path of the source file, when the record was derived from a file."
        },
        "source_sheet": {
          "type": "string",
          "description": "Worksheet name within the source workbook."
        },
        "source_row": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based row number within the source sheet."
        },
        "source_workbook_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 hash of the source workbook."
        },
        "source_dataset_key": {
          "type": "string",
          "description": "Stable key of this dataset within the source catalog, used for idempotent re-ingest."
        },
        "ingest_status": {
          "type": "string",
          "enum": [
            "ready",
            "needs_review",
            "blocked"
          ],
          "description": "Curation status of this entry in the intake pipeline."
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Machine-generated flags noting quality issues found during intake."
        },
        "retrieved_at": {
          "$ref": "#/$defs/UnixTime",
          "description": "Unix timestamp (seconds since epoch, UTC) when the source was retrieved or the record was captured."
        },
        "curated_by": {
          "type": "string",
          "description": "Name or identifier of the person who curated this record."
        },
        "workflow_version": {
          "type": "string",
          "description": "Version of the ingest/curation workflow that produced this record."
        },
        "file_hash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 hash of the source file, for integrity verification."
        },
        "comment": {
          "type": "string",
          "description": "Free-text provenance comment."
        },
        "battinfo_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
          "description": "Version of the battinfo library that wrote this record (semantic versioning); stamped on save."
        }
      },
      "description": "Where the information in this record came from: source type, file or URL, citation, and retrieval time."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-text notes carried with the record."
    },
    "funding": {
      "$ref": "#/$defs/Funding",
      "description": "Funding project (grant) under which the record was produced."
    },
    "contributor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Person"
      },
      "minItems": 1,
      "description": "People who contributed this record to the platform (attribution/provenance). Each is a schema:Person; an ORCID may be given in same_as. Distinct from data authorship (creators)."
    }
  },
  "$defs": {
    "UnixTime": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix timestamp in whole seconds since 1970-01-01T00:00:00Z."
    },
    "ShortId": {
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{6,16}$",
      "description": "Short human-friendly identifier derived from the record IRI (Crockford base32, 6-16 characters)."
    },
    "DatasetIri": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/dataset/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$",
      "description": "Canonical BattINFO IRI in the dataset/ namespace (https://w3id.org/battinfo/dataset/xxxx-xxxx-xxxx-xxxx)."
    },
    "CellTypeIri": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/cell/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$",
      "description": "Canonical BattINFO IRI in the cell/ namespace (https://w3id.org/battinfo/cell/xxxx-xxxx-xxxx-xxxx)."
    },
    "CellIri": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/cell/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$",
      "description": "Canonical BattINFO IRI in the cell/ namespace (https://w3id.org/battinfo/cell/xxxx-xxxx-xxxx-xxxx)."
    },
    "TestIri": {
      "type": "string",
      "pattern": "^https://w3id\\.org/battinfo/test/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$",
      "description": "Canonical BattINFO IRI in the test/ namespace (https://w3id.org/battinfo/test/xxxx-xxxx-xxxx-xxxx)."
    },
    "AboutRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/CellTypeIri"
        },
        {
          "$ref": "#/$defs/CellIri"
        },
        {
          "$ref": "#/$defs/TestIri"
        },
        {
          "type": "string",
          "format": "uri"
        }
      ],
      "description": "Reference to what the dataset is about: a canonical cell or test IRI, or an external URI."
    },
    "Identifier": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/PropertyValue"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/PropertyValue"
              }
            ]
          },
          "minItems": 1
        }
      ],
      "description": "One or more identifiers: plain strings and/or PropertyValue pairs naming the identifier scheme."
    },
    "PropertyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "value"
      ],
      "properties": {
        "property_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier scheme or property IRI the value belongs to."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier value within that scheme."
        }
      },
      "description": "An identifier value qualified by the scheme it belongs to (schema.org PropertyValue)."
    },
    "Person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "type": {
          "const": "Person",
          "description": "JSON-LD type discriminator."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Full name."
        },
        "given_name": {
          "type": "string",
          "minLength": 1,
          "description": "Given (first) name."
        },
        "family_name": {
          "type": "string",
          "minLength": 1,
          "description": "Family (last) name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact e-mail address."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Personal or institutional web page."
        },
        "same_as": {
          "type": "string",
          "format": "uri",
          "description": "External identifier IRI, typically an ORCID (https://orcid.org/...)."
        },
        "affiliation": {
          "$ref": "#/$defs/Organization",
          "description": "Organization the person is affiliated with."
        }
      },
      "description": "A person, in schema.org Person terms; an ORCID may be given in same_as."
    },
    "Organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "type": {
          "const": "Organization",
          "description": "JSON-LD type discriminator."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Organization name."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Homepage URL."
        },
        "same_as": {
          "type": "string",
          "format": "uri",
          "description": "External identifier IRI for this organization (e.g. ROR or Wikidata)."
        }
      },
      "description": "An organization referenced by name, with an optional canonical BattINFO organization IRI."
    },
    "PersonOrOrganization": {
      "anyOf": [
        {
          "$ref": "#/$defs/Person"
        },
        {
          "$ref": "#/$defs/Organization"
        }
      ],
      "description": "Either a Person or an Organization object."
    },
    "DataCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "type": {
          "const": "DataCatalog",
          "description": "JSON-LD type discriminator."
        },
        "id": {
          "type": "string",
          "format": "uri",
          "description": "IRI of the catalog."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Catalog name."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Catalog URL."
        },
        "same_as": {
          "type": "string",
          "format": "uri",
          "description": "External IRI identifying the catalog."
        },
        "description": {
          "type": "string",
          "description": "What the catalog is."
        }
      },
      "description": "A catalog the dataset is listed in."
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "dataset",
            "article",
            "software",
            "other"
          ],
          "description": "What kind of work the citation points to."
        },
        "name": {
          "type": "string",
          "description": "Title of the cited work."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL of the cited work."
        },
        "doi": {
          "type": "string",
          "description": "DOI of the cited work."
        },
        "citation_key": {
          "type": "string",
          "description": "Short key for pairing the citation with in-text references."
        }
      },
      "description": "A related work to cite alongside the dataset."
    },
    "Checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha512",
            "md5",
            "other"
          ],
          "description": "Hash algorithm used."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Hex-encoded digest."
        }
      },
      "description": "Integrity checksum of a distribution file."
    },
    "DataDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_url",
        "encoding_format"
      ],
      "properties": {
        "type": {
          "const": "DataDownload",
          "description": "JSON-LD type discriminator."
        },
        "name": {
          "type": "string",
          "description": "File name or label."
        },
        "description": {
          "type": "string",
          "description": "What the file contains."
        },
        "content_url": {
          "type": "string",
          "format": "uri",
          "description": "Direct download URL of the file."
        },
        "encoding_format": {
          "type": "string",
          "minLength": 1,
          "description": "File format as a media type or format label (e.g. 'text/csv', 'parquet')."
        },
        "content_size": {
          "type": "string",
          "description": "Human-readable file size (e.g. '12.4 MB')."
        },
        "checksum": {
          "$ref": "#/$defs/Checksum",
          "description": "Integrity checksum of the file."
        },
        "access_level": {
          "type": "string",
          "enum": [
            "open",
            "restricted",
            "embargoed",
            "closed",
            "unknown"
          ],
          "description": "Access level of the file."
        },
        "role": {
          "type": "string",
          "description": "Role of this individual file within the dataset (file level): a normalised 'processed' file, the original 'raw' instrument file kept for provenance, a report, a metadata file, or other. The record-level role of the whole dataset is given by DatasetLink.role on the linking record.",
          "enum": [
            "processed",
            "raw",
            "report",
            "metadata",
            "other"
          ]
        },
        "conditions": {
          "type": "object",
          "description": "Per-file measurement conditions (e.g. {\"soc\": 0.5} for EIS files split by SOC).",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {}
          },
          "additionalProperties": false
        }
      },
      "description": "A downloadable file within the dataset (schema.org DataDownload)."
    },
    "CsvwTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url",
        "table_schema"
      ],
      "properties": {
        "type": {
          "const": "Table",
          "description": "JSON-LD type discriminator."
        },
        "id": {
          "type": "string",
          "format": "uri",
          "description": "IRI of this table description."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "File name or URL of the table this description documents."
        },
        "name": {
          "type": "string",
          "description": "Table name."
        },
        "description": {
          "type": "string",
          "description": "What the table contains."
        },
        "table_schema": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/CsvwTableSchema"
            }
          ],
          "description": "Column schema: an inline CsvwTableSchema or the URL of an external schema document."
        }
      },
      "description": "CSVW description of one tabular file."
    },
    "CsvwTableGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "table"
      ],
      "properties": {
        "type": {
          "const": "TableGroup",
          "description": "JSON-LD type discriminator."
        },
        "id": {
          "type": "string",
          "format": "uri",
          "description": "IRI of this table-group description."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "URL associated with the table group."
        },
        "name": {
          "type": "string",
          "description": "Table-group name."
        },
        "description": {
          "type": "string",
          "description": "What the table group contains."
        },
        "table": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CsvwTable"
          },
          "minItems": 1,
          "description": "Member table descriptions."
        }
      },
      "description": "CSVW group of related tables."
    },
    "CsvwMainEntity": {
      "anyOf": [
        {
          "$ref": "#/$defs/CsvwTable"
        },
        {
          "$ref": "#/$defs/CsvwTableGroup"
        }
      ],
      "description": "One or more CSVW table or table-group descriptions."
    },
    "CsvwTableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Column name as it appears in the file header."
        },
        "titles": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ],
          "description": "Human-readable column title(s)."
        },
        "description": {
          "type": "string",
          "description": "What the column contains."
        },
        "datatype": {
          "type": "string",
          "minLength": 1,
          "description": "Column datatype (XSD/CSVW datatype name)."
        },
        "unit_text": {
          "type": "string",
          "minLength": 1,
          "description": "Unit of the column values."
        },
        "same_as": {
          "type": "string",
          "format": "uri",
          "description": "Ontology IRI identifying the physical quantity (e.g. an EMMO class)."
        },
        "required": {
          "type": "boolean",
          "description": "Whether every row must have a value in this column."
        }
      },
      "description": "One column of a tabular file."
    },
    "CsvwTableSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "description": "IRI of this schema description."
        },
        "name": {
          "type": "string",
          "description": "Schema name."
        },
        "description": {
          "type": "string",
          "description": "What the schema describes."
        },
        "primary_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ],
          "description": "Column name(s) forming the primary key."
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CsvwTableColumn"
          },
          "minItems": 1,
          "description": "Ordered column descriptions."
        }
      },
      "description": "Column-level schema of a tabular file."
    },
    "VariableMeasured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Variable name."
        },
        "description": {
          "type": "string",
          "description": "What the variable is."
        },
        "unit_text": {
          "type": "string",
          "description": "Unit of the variable."
        },
        "same_as": {
          "type": "string",
          "format": "uri",
          "description": "Ontology IRI for the variable (e.g. an EMMO class)."
        }
      },
      "description": "A variable (column or signal) recorded in the dataset."
    },
    "Funding": {
      "type": "object",
      "additionalProperties": false,
      "description": "Funding project (grant) under which the record was produced. Maps to schema:funding / schema:Grant in JSON-LD.",
      "required": [
        "identifier"
      ],
      "properties": {
        "type": {
          "const": "Grant",
          "description": "JSON-LD type discriminator."
        },
        "id": {
          "type": "string",
          "format": "uri",
          "description": "Resolvable IRI of the grant (e.g. a CORDIS project IRI)."
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "description": "Grant number as assigned by the funder (e.g. '101069765')."
        },
        "name": {
          "type": "string",
          "description": "Project title."
        },
        "acronym": {
          "type": "string",
          "description": "Project acronym."
        },
        "program": {
          "type": "string",
          "description": "Funding programme or call (e.g. 'Horizon Europe')."
        },
        "funder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "type": {
              "const": "Organization",
              "description": "JSON-LD type discriminator."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Funder name (e.g. 'European Commission')."
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Funder homepage URL."
            },
            "same_as": {
              "type": "string",
              "format": "uri",
              "description": "External identifier IRI for the funder (e.g. a ROR or DOI funder IRI)."
            }
          },
          "description": "Organization that awarded the grant."
        }
      }
    }
  }
}
